# Public client settings from the deployed stack outputs (not secrets — they are embedded in the site).
# Copy to .env.local and restart `npm run dev`. On Vercel, set the same three variables in the project.
VITE_API_BASE_URL=https://<api-id>.execute-api.us-east-2.amazonaws.com/dev
VITE_COGNITO_CLIENT_ID=<UserPoolClientId>
VITE_COGNITO_REGION=us-east-2
